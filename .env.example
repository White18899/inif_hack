# =======================================================
# INFINITY HACKATHON 2026 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and configure your secrets locally.
# NEVER commit .env or .env.local to version control!
# =======================================================

# Cloudflare R2 Bucket Configuration
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_BUCKET_NAME=infinity-hackathon-bucket
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://your-r2-public-domain.r2.dev

# S3 API Credentials for R2 Access
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Application Domain
APP_URL=http://localhost:3000

# Authentication Passphrases (Generate strong, random credentials for production)
ADMIN_SECRET=generate_strong_admin_passphrase_here
COORDINATOR_PASS=generate_strong_coordinator_passphrase_here
JUDGES_PASS=generate_strong_judges_passphrase_here

# Local Development Port
PORT=3000

# Cloudflare Deployment Token (Optional, for Wrangler deployments)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
